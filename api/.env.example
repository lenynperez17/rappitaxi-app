# Server
NODE_ENV=production
PORT=3120

# PostgreSQL local (127.0.0.1 - no SSL)
DATABASE_URL=postgres://rapi_team_user:CHANGEME@127.0.0.1:5432/rapi_team_api

# JWT (HS256) — genera con: openssl rand -base64 64
JWT_SECRET=CHANGEME

# App URLs
NEXT_PUBLIC_APP_URL=https://rapi-team-api.nynelmkt.cloud
APP_BUNDLE_ID_IOS=com.rapiteam.app
APP_BUNDLE_ID_ANDROID=com.rapiteam.app

# Twilio Verify (SMS OTP)
TWILIO_ACCOUNT_SID=CHANGEME
TWILIO_AUTH_TOKEN=CHANGEME
TWILIO_VERIFY_SERVICE_SID=CHANGEME

# Google Sign-In (OAuth Client IDs for token verification)
GOOGLE_CLIENT_ID_ANDROID=CHANGEME
GOOGLE_CLIENT_ID_IOS=CHANGEME
GOOGLE_CLIENT_ID_WEB=CHANGEME

# Apple Sign-In
APPLE_TEAM_ID=78N32BX46K
APPLE_SERVICE_ID=com.rapiteam.app
APPLE_KEY_ID=CHANGEME
APPLE_PRIVATE_KEY_PATH=./AuthKey_HM52J5J9XA.p8

# Passkeys / WebAuthn
WEBAUTHN_RP_ID=rapi-team-api.nynelmkt.cloud
WEBAUTHN_RP_NAME=Rapi Team
WEBAUTHN_ORIGIN=https://rapi-team-api.nynelmkt.cloud

# Firebase (for FCM push + Custom Token minting during transition)
FIREBASE_PROJECT_ID=rapi-team
FIREBASE_CLIENT_EMAIL=CHANGEME
FIREBASE_PRIVATE_KEY=CHANGEME

# Maps proxy cascade
OSRM_URL=https://osrm.nynelmkt.cloud
MAPBOX_ACCESS_TOKEN=CHANGEME
GOOGLE_MAPS_API_KEY=CHANGEME

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=CHANGEME
MERCADOPAGO_PUBLIC_KEY=CHANGEME
MERCADOPAGO_WEBHOOK_SECRET=CHANGEME

# Storage (local disk)
STORAGE_ROOT=/var/www/Rapi-Team-Storage
