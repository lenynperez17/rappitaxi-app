# ============================================================================
# Rapi Team API — Environment example
# NUNCA commitear valores reales aquí. Solo placeholders.
# El .env real vive en el VPS y NO va a git.
# ============================================================================

# Server
NODE_ENV=production
PORT=3120
HOSTNAME=127.0.0.1

# PostgreSQL local (127.0.0.1 - no SSL)
DATABASE_URL=postgres://rapi_team_user:CHANGEME@127.0.0.1:5432/rapi_team_api

# JWT (HS256) — genera con: openssl rand -base64 64
JWT_SECRET=CHANGEME_use_openssl_rand_base64_64

# App URLs
NEXT_PUBLIC_APP_URL=https://your-api-domain.example.com
APP_BUNDLE_ID_IOS=com.example.app
APP_BUNDLE_ID_ANDROID=com.example.app

# Twilio Verify (SMS OTP)
TWILIO_ACCOUNT_SID=CHANGEME
TWILIO_AUTH_TOKEN=CHANGEME
TWILIO_VERIFY_SERVICE_SID=CHANGEME
# Número emisor de SMS (SOS a contactos externos, NO OTP). Formato E.164.
TWILIO_SMS_FROM=CHANGEME_e164_phone

# Test phones para SMS OTP (dev only) — código fijo 1234 para +51999000100
TEST_PHONES_ENABLED=false
SMS_RATE_LIMIT_PER_IP_PER_HOUR=100

# Google Sign-In (OAuth Client IDs for token verification)
GOOGLE_CLIENT_ID_ANDROID=CHANGEME
GOOGLE_CLIENT_ID_IOS=CHANGEME
GOOGLE_CLIENT_ID_WEB=CHANGEME

# Apple Sign-In
APPLE_TEAM_ID=CHANGEME
APPLE_SERVICE_ID=com.example.app
APPLE_KEY_ID=CHANGEME
APPLE_PRIVATE_KEY_PATH=./AuthKey_CHANGEME.p8

# Passkeys / WebAuthn
WEBAUTHN_RP_ID=your-api-domain.example.com
WEBAUTHN_RP_NAME=Your App Name
WEBAUTHN_ORIGIN=https://your-api-domain.example.com

# Firebase (for FCM push + Custom Token minting)
FIREBASE_PROJECT_ID=CHANGEME
FIREBASE_CLIENT_EMAIL=CHANGEME
FIREBASE_PRIVATE_KEY=CHANGEME

# Maps proxy cascade
OSRM_URL=https://your-osrm-instance.example.com
MAPBOX_ACCESS_TOKEN=CHANGEME_pk_xxxx
GOOGLE_MAPS_API_KEY=CHANGEME

# MercadoPago — el código lee MP_ACCESS_TOKEN, con fallback a MERCADOPAGO_ACCESS_TOKEN
MP_ACCESS_TOKEN=CHANGEME
MERCADOPAGO_PUBLIC_KEY=CHANGEME
MERCADOPAGO_WEBHOOK_SECRET=CHANGEME

# Storage (local disk) — DEBE coincidir con nginx alias /_media_internal/
STORAGE_ROOT=/var/www/Rapi-Team-App-Api/storage
STORAGE_MAX_SIZE_MB=15
