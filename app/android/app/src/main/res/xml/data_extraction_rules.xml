<?xml version="1.0" encoding="utf-8"?>
<!-- Ronda 179: bloquear extracción de datos (cloud backup + device-to-device
     transfer). La app maneja PII (DNI, teléfono, email, JWTs, wallet balance)
     que NO debe salir del dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
