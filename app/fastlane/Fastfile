default_platform(:ios)
platform :ios do
  desc "Upload metadata"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: 'HM52J5J9XA', issuer_id: '77515464-9952-4f79-9de5-caa0561b9603',
      key_filepath: '/Users/lenynperez/Proyectos/App-Rapi-Team/app/AuthKey_HM52J5J9XA.p8',
      in_house: false
    )
    deliver(api_key: api_key, skip_binary_upload: true, skip_screenshots: true, force: true,
      submit_for_review: false, automatic_release: false, app_identifier: 'com.rapiteam.app', team_id: '78N32BX46K')
  end

  lane :upload_privacy do
    upload_app_privacy_details_to_app_store(
      username: 'lenynperez17@gmail.com', team_id: '78N32BX46K',
      app_identifier: 'com.rapiteam.app',
      json_path: './fastlane/app_privacy_details.json',
      skip_json_file_saving: true, skip_publish: false
    )
  end

  lane :build_manual do
    build_app(
      workspace: 'ios/Runner.xcworkspace',
      scheme: 'Runner',
      configuration: 'Release',
      output_directory: 'build/ios/ipa',
      output_name: 'Runner.ipa',
      export_method: 'app-store',
      export_options: {
        signingStyle: 'manual',
        teamID: '78N32BX46K',
        provisioningProfiles: {
          'com.rapiteam.app' => 'com.rapiteam.app AppStore'
        }
      }
    )
  end

  # Ronda 266: consulta el estado de la versión en App Store Connect SIN tocar
  # nada. Es imprescindible antes de subir un binario nuevo: si la versión está
  # en `WAITING_FOR_REVIEW` o `IN_REVIEW`, adjuntarle otro build la saca de la
  # cola y reinicia la espera de días. Antes se subía a ciegas.
  lane :review_status do
    api_key = app_store_connect_api_key(
      key_id: 'HM52J5J9XA', issuer_id: '77515464-9952-4f79-9de5-caa0561b9603',
      key_filepath: '/Users/lenynperez/Proyectos/App-Rapi-Team/app/AuthKey_HM52J5J9XA.p8',
      in_house: false
    )
    Spaceship::ConnectAPI.auth(
      key_id: api_key[:key_id], issuer_id: api_key[:issuer_id], key: api_key[:key]
    )
    app = Spaceship::ConnectAPI::App.find('com.rapiteam.app')
    app.get_app_store_versions.first(3).each do |v|
      build = (v.build rescue nil)
      UI.important("#{v.version_string} — #{v.app_store_state} — build #{build&.version || 'sin build'}")
    end
  end

  # Ronda 266: estado de procesado de los últimos builds en TestFlight.
  # `UPLOAD SUCCEEDED` de altool NO significa que el build exista: Apple lo
  # procesa después y puede rechazarlo en silencio. Esto lee la verdad.
  lane :builds_status do
    api_key = app_store_connect_api_key(
      key_id: 'HM52J5J9XA', issuer_id: '77515464-9952-4f79-9de5-caa0561b9603',
      key_filepath: '/Users/lenynperez/Proyectos/App-Rapi-Team/app/AuthKey_HM52J5J9XA.p8',
      in_house: false
    )
    Spaceship::ConnectAPI.auth(
      key_id: api_key[:key_id], issuer_id: api_key[:issuer_id], key: api_key[:key]
    )
    app = Spaceship::ConnectAPI::App.find('com.rapiteam.app')
    Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: '-version', limit: 5).each do |b|
      UI.important("build #{b.version} — #{b.processing_state} — expira #{b.expired ? 'SI' : 'no'}")
    end
  end

  # Ronda 269: por qué Apple rechaza mandar una versión a revisión.
  #
  # Al enviar el 1.3.3 la API contestó solo "This resource cannot be reviewed,
  # please check associated errors to see why" — sin decir cuál. Esta lane
  # enseña las piezas que Apple exige por separado (build enganchado, capturas
  # por idioma, datos de contacto de revisión) para no ir a ciegas.
  lane :version_blockers do |options|
    version = options[:version] or UI.user_error!('Falta version: fastlane version_blockers version:1.3.3')
    api_key = app_store_connect_api_key(
      key_id: 'HM52J5J9XA', issuer_id: '77515464-9952-4f79-9de5-caa0561b9603',
      key_filepath: '/Users/lenynperez/Proyectos/App-Rapi-Team/app/AuthKey_HM52J5J9XA.p8',
      in_house: false
    )
    Spaceship::ConnectAPI.auth(
      key_id: api_key[:key_id], issuer_id: api_key[:issuer_id], key: api_key[:key]
    )
    app = Spaceship::ConnectAPI::App.find('com.rapiteam.app')
    v = app.get_app_store_versions.find { |x| x.version_string == version }
    UI.user_error!("No existe la versión #{version}") if v.nil?

    UI.important("version #{v.version_string} — #{v.app_store_state} — release #{v.release_type}")
    UI.important("build: #{(v.build&.version rescue nil) || 'NINGUNO'}")

    # Solo se dice si cada dato ESTÁ, nunca su valor: esta salida acaba en el
    # log de fastlane, que se pega en chats y se sube a CI. Para saber por qué
    # Apple bloquea la versión basta con "falta" o "está".
    detail = (v.fetch_app_store_review_detail rescue nil)
    contacto = detail && !detail.contact_email.to_s.empty? && !detail.contact_phone.to_s.empty?
    UI.important("datos de contacto de revisión: #{contacto ? 'completos' : 'FALTAN'}")
    demo_ok = detail && !detail.demo_account_name.to_s.empty? && !detail.demo_account_password.to_s.empty?
    UI.important("cuenta demo: #{detail&.demo_account_required ? (demo_ok ? 'configurada' : 'REQUERIDA Y VACÍA') : 'no requerida'}")

    v.get_app_store_version_localizations.each do |loc|
      sets = (loc.get_app_screenshot_sets rescue [])
      total = sets.sum { |s| (s.app_screenshots || []).size }
      UI.important("#{loc.locale}: #{sets.size} tamaño(s) de captura, #{total} imagen(es) · notas #{loc.whats_new.to_s.empty? ? 'VACÍAS' : 'ok'}")
    end
  end

  # Ronda 269: borra un idioma de una versión que aún no se ha enviado.
  #
  # Hizo falta porque la carpeta local de metadatos se llamaba `es-MX` mientras
  # la ficha de la App Store vive en `es-ES`. `deliver` creó el idioma que le
  # decía la carpeta, y un idioma nuevo nace SIN capturas: Apple rechazaba la
  # versión entera con un escueto "cannot be reviewed" sin decir cuál faltaba.
  #
  # Uso: fastlane drop_locale version:1.3.3 locale:es-MX
  # Ronda 278: saca una versión de la cola de revisión de Apple.
  #
  # Sólo puede haber una versión editable a la vez: mientras la 1.3.4 esté en
  # WAITING_FOR_REVIEW no se puede crear la 1.3.5. Y si la que espera lleva un
  # fallo dentro —el nombre mal escrito—, dejar que se apruebe es peor que
  # perder el sitio en la cola.
  #
  # Uso: fastlane withdraw_review version:1.3.4
  lane :withdraw_review do |options|
    version = options[:version] or UI.user_error!('Falta version: fastlane withdraw_review version:1.3.4')
    api_key = app_store_connect_api_key(
      key_id: 'HM52J5J9XA', issuer_id: '77515464-9952-4f79-9de5-caa0561b9603',
      key_filepath: '/Users/lenynperez/Proyectos/App-Rapi-Team/app/AuthKey_HM52J5J9XA.p8',
      in_house: false
    )
    Spaceship::ConnectAPI.auth(
      key_id: api_key[:key_id], issuer_id: api_key[:issuer_id], key: api_key[:key]
    )
    app = Spaceship::ConnectAPI::App.find('com.rapiteam.app')
    v = app.get_app_store_versions.find { |x| x.version_string == version }
    UI.user_error!("No existe la versión #{version}") if v.nil?
    UI.important("#{version} está en #{v.app_store_state}")

    # La retirada se hace sobre el `reviewSubmission` que la contiene, no sobre
    # la versión: es lo que Apple tiene realmente encolado.
    envios = app.get_review_submissions(
      filter: { state: 'WAITING_FOR_REVIEW,IN_REVIEW,UNRESOLVED_ISSUES' },
    )
    if envios.nil? || envios.empty?
      UI.important('No hay ningún envío en cola que retirar')
    else
      Array(envios).each do |s|
        s.cancel_submission
        UI.success("Envío #{s.id} retirado de la cola")
      end
    end
  end

  lane :drop_locale do |options|
    version = options[:version] or UI.user_error!('Falta version:')
    locale  = options[:locale]  or UI.user_error!('Falta locale:')
    api_key = app_store_connect_api_key(
      key_id: 'HM52J5J9XA', issuer_id: '77515464-9952-4f79-9de5-caa0561b9603',
      key_filepath: '/Users/lenynperez/Proyectos/App-Rapi-Team/app/AuthKey_HM52J5J9XA.p8',
      in_house: false
    )
    Spaceship::ConnectAPI.auth(
      key_id: api_key[:key_id], issuer_id: api_key[:issuer_id], key: api_key[:key]
    )
    app = Spaceship::ConnectAPI::App.find('com.rapiteam.app')
    v = app.get_app_store_versions.find { |x| x.version_string == version }
    UI.user_error!("No existe la versión #{version}") if v.nil?
    UI.user_error!("La versión #{version} ya está en #{v.app_store_state}; no se toca") unless v.app_store_state == 'PREPARE_FOR_SUBMISSION'

    loc = v.get_app_store_version_localizations.find { |l| l.locale == locale }
    if loc.nil?
      UI.important("La versión #{version} no tiene el idioma #{locale}; nada que borrar")
    else
      loc.delete!
      UI.success("Idioma #{locale} borrado de la versión #{version}")
    end
  end

  # Ronda 269: crea la versión en App Store Connect, le engancha el build ya
  # procesado y la manda a revisión para producción.
  #
  # Antes este paso se hacía a mano con curl contra `reviewSubmissions` +
  # `reviewSubmissionItems`, reconstruyendo el JWT ES256 cada vez. `deliver`
  # hace lo mismo y además sube las notas de versión, que Apple exige en cada
  # versión nueva y que se olvidaban al ir por la API cruda.
  #
  # Uso: fastlane submit_release version:1.3.3 build:187
  # Comprueba SIEMPRE `fastlane review_status` antes: si ya hay una versión en
  # WAITING_FOR_REVIEW o IN_REVIEW, esto la reinicia y se pierden días de cola.
  lane :submit_release do |options|
    version = options[:version] or UI.user_error!('Falta version: fastlane submit_release version:1.3.3 build:187')
    build   = options[:build]   or UI.user_error!('Falta build: fastlane submit_release version:1.3.3 build:187')
    api_key = app_store_connect_api_key(
      key_id: 'HM52J5J9XA', issuer_id: '77515464-9952-4f79-9de5-caa0561b9603',
      key_filepath: '/Users/lenynperez/Proyectos/App-Rapi-Team/app/AuthKey_HM52J5J9XA.p8',
      in_house: false
    )
    deliver(
      api_key: api_key,
      app_version: version,
      build_number: build,
      app_identifier: 'com.rapiteam.app',
      team_id: '78N32BX46K',
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      overwrite_screenshots: false,
      force: true,                      # sin confirmación interactiva del HTML
      submit_for_review: true,
      automatic_release: true,          # publica solo en cuanto Apple apruebe
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end

  lane :upload_ipa do
    api_key = app_store_connect_api_key(
      key_id: 'HM52J5J9XA', issuer_id: '77515464-9952-4f79-9de5-caa0561b9603',
      key_filepath: '/Users/lenynperez/Proyectos/App-Rapi-Team/app/AuthKey_HM52J5J9XA.p8',
      in_house: false
    )
    upload_to_app_store(
      api_key: api_key, skip_metadata: true, skip_screenshots: true, force: true,
      ipa: 'build/ios/ipa/Runner.ipa',
      app_identifier: 'com.rapiteam.app', team_id: '78N32BX46K',
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
    # Ronda 268: se ELIMINA la llamada a distribute_to_internal_group.sh.
    #
    # Ese script existía (ronda 196) porque Apple no dejaba activar
    # `hasAccessToAllBuilds=true` por API pública, así que había que asignar
    # cada build al grupo interno a mano. Desde la ronda 224 el grupo
    # "Team Rapi Auto" ya lo tiene activado y Apple asigna solo.
    #
    # Mantenerlo hacía daño: al subir el 186 se quedó 36 minutos haciendo
    # polling y terminó marcando la lane entera como fallida cuando la subida
    # había ido perfectamente — el build estaba VALID en TestFlight desde el
    # primer minuto. Un fallo falso en el deploy es peor que no tener el paso.
    #
    # Para comprobar que un build llegó: `fastlane builds_status`.
  end
end
