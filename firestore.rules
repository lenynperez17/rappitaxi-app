// =============================================================================
// Firestore rules — DENY ALL (deprecated).
// =============================================================================
// La app Rapi Team migro de Firebase → backend Node/Postgres (ver
// project_firebase_migration_complete). Firestore ya no se lee ni se escribe
// desde la app ni desde el panel admin. Las reglas anteriores contenian
// agujeros (ownership no chequeada en chat_messages, drivers podian UPDATE
// cualquier ride que no fuera suyo) que nadie estaba monitoreando porque el
// flujo real corre por Postgres. Ronda 19 MEDIUM#5.
//
// Si alguna vez se necesita volver a usar Firestore, restaurar del historial
// git commit 6623803^ (antes de este deny-all) y REVISAR cada rule antes.
// =============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
