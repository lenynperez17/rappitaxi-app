// =============================================================================
// Firebase Storage rules — DENY ALL (deprecated).
// =============================================================================
// La app Rapi Team migro de Firebase Storage → storage local del VPS
// (/var/www/Rapi-Team-Storage/) servido con X-Accel-Redirect via nginx. Los
// uploads pasan por /api/storage/upload con ACL en Node/Postgres. Firebase
// Storage ya no se usa; las reglas anteriores permitian /chat_media/{rideId}
// a cualquier autenticado sin check de ownership y confiaban en
// resource.metadata.userRole para el isAdmin() check. Deny all para cerrar
// esa superficie. Ronda 19 MEDIUM#5.
//
// Si se necesita volver a usar Storage, restaurar del git commit 6623803^ y
// AUDITAR cada rule antes de deploy.
// =============================================================================
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
